        },
        {
          "columna_0": "",
          "columna_1": "3",
          "columna_2": "IMPLEMENTACIÓN DE  PUERTAS ACRÍLICAS DE PROTECCIÒN(TIPO CORREDIZA).",
          "columna_3": "Se requiere la colocacion de puertas acrìlicas tipo corrediza, transparentes para todos los compartimientos.",
          "columna_4": "Todos los compartimientos del TDF N°2B.",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "",
