        },
        {
          "columna_0": "",
          "columna_1": "1",
          "columna_2": "IMPLEMENTACIÓN DE SEÑALIZACIÓN DE ADVERTENCIA Y PELIGRO ",
          "columna_3": "El \"TDF N°2B\" debe tener señalización de advertencia y peligro claramente visible, de acuerdo a la norma DGE \"Símbolos Gráficos en Electricidad\".\n\n\n\n\n\n",
          "columna_4": "TDF N°2B \nTablero de Supresor de Picos",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "",
          "columna_2": "",
          "columna_3": "",
          "columna_4": "",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "2",
          "columna_2": "SE REQUIERE CAMBIO DE COLOR DE LOS CONDUCTORES DE PUESTA A TIERRA ",
          "columna_3": "Se requiere realizar el cambio de colores de dichos conductores de puesta a tierra de todos los compartimientos que están con color negro por colores verde,amarillo o verde con franjas amarillas según CNE 030-036.",
          "columna_4": "TDF N°2B",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "",
          "columna_2": "",
          "columna_3": "",
          "columna_4": "",
