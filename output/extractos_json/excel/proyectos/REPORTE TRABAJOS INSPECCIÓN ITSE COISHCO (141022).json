        },
        {
          "columna_0": "",
          "columna_1": "4",
          "columna_2": "FALTA ATERRAR CARCASA METÁLICA DE EQUIPOS ELÉCTRICOS",
          "columna_3": "Se requiere aterrar las carcasas metálicas de equipos con su cable de protección de puesta a tierra con sección de 4mm2 NH-80(T).",
          "columna_4": "Estabilizador de Voltaje - 20kVA\nCondensadores ubic. en el 3°Piso-Oficinas\"CHI\"\nRack Data Sistema\n",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "5",
          "columna_2": "FALTA IMPLEMENTAR TAPAS RESERVA EN TABLEROS Y CAJA DE PASE",
          "columna_3": "Se requiere implementar tapas reservas en los espacios vacíos de los tableros e implementar tapas en las cajas de pase, ya que se encuentran conexiones expuestas.",
          "columna_4": "Estabilizador de Voltaje - 20kVA\nCondensadores ubic. en el 3°Piso-Oficinas\"CHI\"\nRack Data Sistema\nCaja de Pase ubicado en el 3° Piso - Oficinas \"CHI\"",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "6",
          "columna_2": "FALTA IMPLEMENTAR CANALIZACIONES",
          "columna_3": "Se requiere implementar canalizaciones para la protección de todas las conexiones y cables expuestos ya sea con tubería corrugada flexible o PVC.",
          "columna_4": "Condensadores ubic. en el 3°Piso-Oficinas\"CHI\"\nTablero de Refrigerador y mesa de frío",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "7",
          "columna_2": "FALTA ATERRAR TODOS LOS CIRCUITOS ",
          "columna_3": "Se requiere implementar cable de protección de puesta a tierra desde la barra y/o bornera de puesta a tierra a todos los circuitos derivados de dicho tablero con conductor de sección 4mm2 NH-80(T).",
          "columna_4": "Tablero Tomacorrientes, Línea Estabilizada",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "8",
          "columna_2": "FALTA IMPLEMENTAR DISPOSITIVOS ELECTROMECÁNICOS DE PROTECCIÓN ",
          "columna_3": "Se requiere implementar interruptores diferenciales para circuitos de iluminación, tomac. y AAC (3 unds. de 2x40A con una sensibilidad de 30mA.",
          "columna_4": "Tablero de Distribución General \"T-AD1.6\" (Laboratorio de Aseguramiento de Calidad)",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "9",
          "columna_2": "FALTA IMPLEMENTAR DISPOSITIVOS ELECTROMECÁNICOS DE PROTECCIÓN ",
          "columna_3": "Se requiere implementar interruptor diferencial en cabecera para circuitos de iluminación, tomac. y AAC \n(1 und. de 4x25A con una sensibilidad de 30mA.",
          "columna_4": "Tablero de Distribución Alumbrado y Tomac. En Edificio \"CHI\" (2°Piso)",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "10",
          "columna_2": "FALTA IMPLEMENTAR DISPOSITIVOS ELECTROMECÁNICOS DE PROTECCIÓN ",
          "columna_3": "Se requiere implementar interruptores diferenciales para circuitos de tomacorrientes (3 unds. de 2x25A con una sensibilidad de 30mA.",
          "columna_4": "Tablero de Distribución Principal \"T-AD2.2\"\n Edificio \"CHI\" (2°Piso)",
          "columna_5": ""
        },
        {
          "columna_0": "",
          "columna_1": "12",
          "columna_2": "FALTA IMPLEMENTAR DISPOSITIVOS ELECTROMECÁNICOS DE PROTECCIÓN ",
          "columna_3": "Se requiere implementar interruptor general de 3x63A junto a su interruptor diferencial de cabecera de 4x63A con una sensib.de 30mA",
          "columna_4": "Tablero de Distribución Equipos de Cocina \"T-AD3.2\"\n Edificio \"CHI\" (3°Piso)",
          "columna_5": ""
        },
        {
