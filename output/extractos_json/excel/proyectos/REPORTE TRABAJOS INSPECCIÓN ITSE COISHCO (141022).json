        {
          "columna_0": "",
          "columna_1": "3",
          "columna_2": "FALTA IMPLEMENTAR SEÑALIZACIÓN DE RIESGO Y PELIGRO ELÉCTRICO",
          "columna_3": "Se requiere implementar sticker de señalización de riesgo y peligro eléctrico.",
